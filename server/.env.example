# Backend runtime and database
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/cosmetics-ecommerce

# Session signing keys (use independent random values outside local development)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth callback must exactly match the URL registered in Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback

# Optional GitHub OAuth provider
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/oauth/github/callback

# Transactional email used for verification and password setup links
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Existing image storage configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
